# ============================================
# Royal Farms - Production Environment Variables
# Copy this file to .env.production and fill in your values
# ============================================

# Database Password (used by both PostgreSQL container and the app)
DB_PASSWORD=RoyalFarmsDB2026!

# NextAuth - Authentication
# Generate a secret: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-key-here

# NextAuth URL - Your domain (update this to your actual domain)
NEXTAUTH_URL=https://yourdomain.com

# NOTE: DATABASE_URL is automatically constructed in docker-compose.yml
# You do NOT need to set it here. It uses:
# postgresql://royalfarms_admin:<DB_PASSWORD>@db:5432/royalfarms?schema=public
